# Copy values into the process environment or into a private config file
# such as /workspace/.tesla-mcp/config.env (mode 600). Never commit real values.

TESLA_CLIENT_ID=your_client_id_here
TESLA_CLIENT_SECRET=your_client_secret_here
TESLA_TOKEN_KEY=your_base64_token_key_here

# China vehicles: cn. North America / most APAC: na. Europe: eu.
TESLA_REGION=cn

# China region usually needs China auth hosts (set explicitly if your
# connector build defaults to global auth.tesla.com):
# TESLA_AUTH_URL=https://auth.tesla.cn/oauth2/v3/authorize
# TESLA_TOKEN_URL=https://auth.tesla.cn/oauth2/v3/token

# Opt-in only
# TESLA_ENABLE_LOCATION=false
# TESLA_ENABLE_CHARGING_HISTORY=false
